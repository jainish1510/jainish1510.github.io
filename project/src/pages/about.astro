---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="about-page">
		<a href="/" class="back-button">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M19 12H5M12 19l-7-7 7-7"/>
			</svg>
			Back to Home
		</a>

		<div class="page-header">
			<h1>About Me</h1>
			<p class="subtitle">Get to know me better</p>
		</div>

		<div class="grid-container">
			<div class="card main-card">
				<div class="card-header">
					<h2>Who I Am</h2>
				</div>
				<div class="card-content">
					<p>
						I'm a passionate developer and designer focused on creating elegant solutions to complex problems.
						With a keen eye for detail and a love for clean code, I strive to build experiences that are both
						beautiful and functional.
					</p>
					<p>
						My journey in tech started with curiosity and has evolved into a deep commitment to craftsmanship.
						I believe in continuous learning, meaningful collaboration, and the power of design to transform ideas
						into reality.
					</p>
					<div class="tags">
						<span class="tag">JavaScript</span>
						<span class="tag">TypeScript</span>
						<span class="tag">React</span>
						<span class="tag">Node.js</span>
						<span class="tag">UI/UX</span>
						<span class="tag">Figma</span>
					</div>
				</div>
			</div>

			<div class="card spotify-card">
				<div class="card-header">
					<svg viewBox="0 0 24 24" fill="currentColor" class="spotify-icon">
						<path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
					</svg>
					<h3>Currently Playing</h3>
				</div>
				<div class="card-content">
					<div class="spotify-content">
						<div class="album-art">♪</div>
						<div class="track-info">
							<p class="track-name">Your Favorite Song</p>
							<p class="artist-name">Artist Name</p>
						</div>
					</div>
					<div class="spotify-footer">
						<span class="listening-badge">🎧 Listening on Spotify</span>
					</div>
				</div>
			</div>

			<div class="card stats-card">
				<div class="card-header">
					<h3>Quick Stats</h3>
				</div>
				<div class="card-content">
					<div class="stat-item">
						<div class="stat-number">5+</div>
						<div class="stat-label">Years Experience</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">50+</div>
						<div class="stat-label">Projects Completed</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">100%</div>
						<div class="stat-label">Coffee Powered</div>
					</div>
				</div>
			</div>

			<div class="card location-card">
				<div class="card-header">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<h3>Location</h3>
				</div>
				<div class="card-content">
					<p class="location-text">📍 San Francisco, CA</p>
					<p class="timezone">PST (UTC-8)</p>
				</div>
			</div>

			<div class="card availability-card">
				<div class="card-header">
					<h3>Availability</h3>
				</div>
				<div class="card-content">
					<div class="status-indicator">
						<span class="status-dot available"></span>
						<span class="status-text">Available for freelance</span>
					</div>
					<p class="availability-note">Open to new opportunities and collaborations</p>
				</div>
			</div>

			<div class="card interests-card">
				<div class="card-header">
					<h3>Interests</h3>
				</div>
				<div class="card-content">
					<ul class="interests-list">
						<li>🎨 UI/UX Design</li>
						<li>💻 Web Development</li>
						<li>📚 Reading Tech Books</li>
						<li>🎮 Gaming</li>
						<li>🏃 Running</li>
						<li>☕ Coffee Enthusiast</li>
					</ul>
				</div>
			</div>

			<div class="card tools-card">
				<div class="card-header">
					<h3>Tools I Use</h3>
				</div>
				<div class="card-content">
					<div class="tools-grid">
						<div class="tool-item">
							<div class="tool-icon">VS</div>
							<span>VS Code</span>
						</div>
						<div class="tool-item">
							<div class="tool-icon">FG</div>
							<span>Figma</span>
						</div>
						<div class="tool-item">
							<div class="tool-icon">GH</div>
							<span>GitHub</span>
						</div>
						<div class="tool-item">
							<div class="tool-icon">PS</div>
							<span>Postman</span>
						</div>
					</div>
				</div>
			</div>

			<div class="card learning-card">
				<div class="card-header">
					<h3>Currently Learning</h3>
				</div>
				<div class="card-content">
					<div class="learning-items">
						<div class="learning-item">
							<div class="progress-bar">
								<div class="progress-fill" style="width: 75%"></div>
							</div>
							<span class="learning-label">Web3 & Blockchain</span>
						</div>
						<div class="learning-item">
							<div class="progress-bar">
								<div class="progress-fill" style="width: 60%"></div>
							</div>
							<span class="learning-label">Machine Learning</span>
						</div>
						<div class="learning-item">
							<div class="progress-bar">
								<div class="progress-fill" style="width: 85%"></div>
							</div>
							<span class="learning-label">System Design</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	.about-page {
		min-height: 100vh;
		background: #f8f9fa;
		padding: 40px 32px 80px;
	}

	.back-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 20px;
		background: white;
		border: 1px solid #e5e7eb;
		border-radius: 12px;
		text-decoration: none;
		color: #1a1a1a;
		font-weight: 500;
		transition: all 0.3s ease;
		margin-bottom: 40px;
	}

	.back-button svg {
		width: 20px;
		height: 20px;
	}

	.back-button:hover {
		background: #1a1a1a;
		color: white;
		transform: translateX(-4px);
	}

	.page-header {
		max-width: 1200px;
		margin: 0 auto 60px;
	}

	.page-header h1 {
		font-size: 56px;
		font-weight: 600;
		margin-bottom: 12px;
		letter-spacing: -0.02em;
	}

	.subtitle {
		font-size: 20px;
		color: #666;
		font-weight: 300;
	}

	.grid-container {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 24px;
		grid-auto-flow: dense;
	}

	.card {
		background: white;
		border-radius: 20px;
		padding: 28px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
		border: 1px solid rgba(0, 0, 0, 0.05);
		transition: all 0.3s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
	}

	.main-card {
		grid-column: span 2;
	}

	.card-header {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 20px;
	}

	.card-header h2 {
		font-size: 28px;
		font-weight: 600;
		margin: 0;
	}

	.card-header h3 {
		font-size: 20px;
		font-weight: 600;
		margin: 0;
	}

	.card-header svg {
		width: 24px;
		height: 24px;
		color: #1a1a1a;
	}

	.card-content p {
		font-size: 16px;
		line-height: 1.7;
		color: #4a4a4a;
		margin-bottom: 16px;
	}

	.card-content p:last-child {
		margin-bottom: 0;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
	}

	.tag {
		padding: 8px 16px;
		background: #f0f0f0;
		border-radius: 20px;
		font-size: 14px;
		font-weight: 500;
		color: #1a1a1a;
		transition: all 0.3s ease;
	}

	.tag:hover {
		background: #1a1a1a;
		color: white;
	}

	.spotify-icon {
		color: #1DB954;
	}

	.spotify-content {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 16px;
	}

	.album-art {
		width: 64px;
		height: 64px;
		background: linear-gradient(135deg, #1DB954 0%, #1ed760 100%);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28px;
		color: white;
	}

	.track-info {
		flex: 1;
	}

	.track-name {
		font-size: 16px;
		font-weight: 600;
		margin-bottom: 4px;
	}

	.artist-name {
		font-size: 14px;
		color: #888;
	}

	.listening-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 12px;
		background: #f0f9f4;
		color: #1DB954;
		border-radius: 12px;
		font-size: 13px;
		font-weight: 500;
	}

	.stats-card .card-content {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.stat-item {
		text-align: center;
	}

	.stat-number {
		font-size: 36px;
		font-weight: 700;
		color: #1a1a1a;
		margin-bottom: 8px;
	}

	.stat-label {
		font-size: 14px;
		color: #888;
		font-weight: 500;
	}

	.location-text {
		font-size: 18px;
		font-weight: 600;
		margin-bottom: 8px;
	}

	.timezone {
		font-size: 14px;
		color: #888;
	}

	.status-indicator {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 12px;
	}

	.status-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		position: relative;
	}

	.status-dot.available {
		background: #10b981;
		animation: pulse 2s infinite;
	}

	@keyframes pulse {
		0%, 100% {
			box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
		}
		50% {
			box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
		}
	}

	.status-text {
		font-size: 16px;
		font-weight: 600;
	}

	.availability-note {
		font-size: 14px;
		color: #888;
	}

	.interests-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 12px;
	}

	.interests-list li {
		font-size: 15px;
		color: #4a4a4a;
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
	}

	.tool-item {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 14px;
		font-weight: 500;
	}

	.tool-icon {
		width: 40px;
		height: 40px;
		background: #1a1a1a;
		color: white;
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		font-weight: 700;
	}

	.learning-items {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.learning-item {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.progress-bar {
		height: 8px;
		background: #f0f0f0;
		border-radius: 4px;
		overflow: hidden;
	}

	.progress-fill {
		height: 100%;
		background: linear-gradient(90deg, #1a1a1a 0%, #4a4a4a 100%);
		border-radius: 4px;
		transition: width 0.5s ease;
	}

	.learning-label {
		font-size: 14px;
		color: #4a4a4a;
		font-weight: 500;
	}

	@media (max-width: 768px) {
		.about-page {
			padding: 32px 24px 60px;
		}

		.page-header h1 {
			font-size: 40px;
		}

		.grid-container {
			grid-template-columns: 1fr;
		}

		.main-card {
			grid-column: span 1;
		}

		.interests-list {
			grid-template-columns: 1fr;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
