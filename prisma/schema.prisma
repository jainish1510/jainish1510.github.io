// ─────────────────────────────────────────────────────────────────────────────
// Jainish Patel — Research Studio
//
// SQLite-first relational schema. Enumerated values are stored as strings and
// validated in the application layer (src/lib/validation) so the same schema
// moves to PostgreSQL / MySQL / libSQL by changing only the datasource.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("ADMIN") // ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  posts        Post[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ─── Publication ─────────────────────────────────────────────────────────────

model Post {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  subtitle       String?
  excerpt        String?
  content        String // Markdown with extensions (math, mermaid, directives)
  status         String         @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  featured       Boolean        @default(false)
  readingTime    Int            @default(1) // minutes
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  isDemo         Boolean        @default(false) // seeded demonstration content
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverId        String?
  cover          Media?         @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  tags           Tag[]
  areas          ResearchArea[]
  revisions      PostRevision[]
  comments       Comment[]
  likes          Like[]
  bookmarks      Bookmark[]
  views          View[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  content   String
  note      String? // "autosave", "publish", "manual"
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  posts       Post[]
  createdAt   DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
}

// ─── Engagement ──────────────────────────────────────────────────────────────

model Comment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?      @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("Thread")
  depth       Int           @default(0) // 0..2  (max 3 visible levels)
  authorName  String
  authorEmail String?
  content     String // plain text only; never rendered as HTML
  status      String        @default("PENDING") // PENDING | APPROVED | REJECTED | SPAM
  isAuthor    Boolean       @default(false) // reply written by the admin
  isDemo      Boolean       @default(false)
  visitorId   String?
  ipHash      String?
  spamScore   Int           @default(0)
  likes       CommentLike[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId, status])
  @@index([status, createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([commentId, visitorId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
}

model View {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  referrer  String?
  device    String? // desktop | mobile | tablet | bot
  metadata  String? // small JSON blob (e.g. { "demo": true })
  createdAt DateTime @default(now())

  @@index([postId, visitorId, createdAt])
  @@index([createdAt])
}

model Event {
  id         String   @id @default(cuid())
  type       String // project_click | outbound_click | search
  entityType String?
  entityId   String?
  visitorId  String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
}

// ─── Media ───────────────────────────────────────────────────────────────────

model Media {
  id               String            @id @default(cuid())
  filename         String // stored file name (random)
  originalName     String
  path             String            @unique // public URL path, e.g. /media/blog/abc.png
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  alt              String            @default("")
  caption          String?
  folder           String            @default("MISC") // BLOG | PROJECTS | RESEARCH | PROFILE | MISC
  postCovers       Post[]            @relation("PostCover")
  projectCovers    Project[]         @relation("ProjectCover")
  projectGalleries Project[]         @relation("ProjectGallery")
  researchFigures  ResearchProject[] @relation("ResearchFigures")
  createdAt        DateTime          @default(now())

  @@index([folder])
}

// ─── Portfolio ───────────────────────────────────────────────────────────────

model Project {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  summary       String
  category      String // ML | RESEARCH | WEB | CLOUD | AI | SYSTEMS
  status        String            @default("COMPLETED") // ACTIVE | COMPLETED | PROTOTYPE | ARCHIVED
  startDate     DateTime?
  endDate       DateTime?
  githubUrl     String?
  demoUrl       String?
  videoUrl      String?
  problem       String? // markdown
  motivation    String? // markdown
  architecture  String? // markdown (mermaid supported)
  howItWorks    String? // markdown
  challenges    String? // markdown
  results       String? // markdown
  lessons       String? // markdown
  recognition   String? // e.g. hackathon result, copied verbatim from the CV
  featured      Boolean           @default(false)
  isPlaceholder Boolean           @default(false) // details still to be written
  order         Int               @default(0)
  coverId       String?
  cover         Media?            @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  gallery       Media[]           @relation("ProjectGallery")
  skills        Skill[]
  areas         ResearchArea[]
  research      ResearchProject[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ResearchProject {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  abstract      String
  question      String?
  methodology   String? // markdown
  datasets      String? // markdown
  experiments   String? // markdown
  results       String? // markdown
  publication   String? // citation, only if real
  codeUrl       String?
  collaborators String?
  institution   String?
  status        String         @default("ONGOING") // ONGOING | COMPLETED | PLANNED
  startDate     DateTime?
  endDate       DateTime?
  featured      Boolean        @default(false)
  isPlaceholder Boolean        @default(false)
  order         Int            @default(0)
  areas         ResearchArea[]
  skills        Skill[]
  projects      Project[]
  figures       Media[]        @relation("ResearchFigures")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Nodes of the interactive research graph. Parent/child forms the tree; the
/// many-to-many relations connect each area to work, writing and tools.
model ResearchArea {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  parentId    String?
  parent      ResearchArea?     @relation("AreaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ResearchArea[]    @relation("AreaTree")
  order       Int               @default(0)
  posts       Post[]
  projects    Project[]
  research    ResearchProject[]
  skills      Skill[]
}

model Experience {
  id           String   @id @default(cuid())
  role         String
  organization String
  location     String?
  type         String   @default("WORK") // WORK | INTERNSHIP | RESEARCH | LEADERSHIP
  startDate    DateTime
  endDate      DateTime?
  current      Boolean  @default(false)
  period       String? // display override when exact dates are unknown, e.g. "Summer 2025"
  summary      String?
  highlights   String? // one highlight per line
  url          String?
  order        Int      @default(0)
  skills       Skill[]
  createdAt    DateTime @default(now())
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  expected    Boolean   @default(false)
  notes       String? // one item per line
  order       Int       @default(0)
}

model Award {
  id          String    @id @default(cuid())
  title       String
  issuer      String
  date        DateTime?
  description String?
  url         String?
  order       Int       @default(0)
}

model Skill {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  category    String // LANGUAGES | FRAMEWORKS | ML | CLOUD | DATABASES | INFRASTRUCTURE | RESEARCH | TOOLS
  usedFor     String? // one use per line
  proficiency Int               @default(3) // 1..5
  favorite    Boolean           @default(false) // shows in "favorite tools"
  order       Int               @default(0)
  projects    Project[]
  research    ResearchProject[]
  experiences Experience[]
  areas       ResearchArea[]
}

// ─── Personal ────────────────────────────────────────────────────────────────

model SocialLink {
  id       String  @id @default(cuid())
  platform String // github | linkedin | email | spotify | x | website | rss
  label    String
  url      String
  handle   String?
  order    Int     @default(0)
  visible  Boolean @default(true)
}

/// Rows of the "Currently" block on the homepage.
model NowItem {
  id     String  @id @default(cuid())
  label  String // Studying, Research, Building, Learning, Location
  value  String
  detail String?
  icon   String  @default("dot")
  order  Int     @default(0)
}

model TimelineEvent {
  id          String  @id @default(cuid())
  year        Int
  title       String
  description String?
  kind        String  @default("MILESTONE") // EDUCATION | RESEARCH | WORK | BUILD | COMMUNITY | MILESTONE
  link        String?
  order       Int     @default(0)
}

model LearningItem {
  id       String  @id @default(cuid())
  topic    String
  note     String?
  progress Int     @default(0) // 0..100
  order    Int     @default(0)
}

model Fact {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)
}

model Book {
  id     String  @id @default(cuid())
  title  String
  author String
  note   String?
  status String  @default("READ") // READING | READ | QUEUED
  url    String?
  order  Int     @default(0)
}

model Interest {
  id          String  @id @default(cuid())
  name        String
  description String?
  order       Int     @default(0)
}

model Goal {
  id      String @id @default(cuid())
  text    String
  horizon String @default("2026")
  order   Int    @default(0)
}

/// Configuration + last-known data for dynamic widgets (Spotify, GitHub …).
model PersonalWidget {
  id        String   @id @default(cuid())
  key       String   @unique // spotify | github | clock | random_fact
  title     String
  enabled   Boolean  @default(true)
  config    String   @default("{}") // small JSON object, validated per widget
  cache     String? // last successful payload from the external API
  cachedAt  DateTime?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Typed site settings, one row per key (see src/lib/settings.ts).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  ipHash    String?
  createdAt DateTime @default(now())
}
