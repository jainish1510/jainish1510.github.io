---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<section class="hero">
			<div class="container">
				<h1>Your Name</h1>
				<p class="subtitle">Designer & Developer</p>
			</div>
		</section>

		<section class="about">
			<div class="container">
				<h2>About</h2>
				<p>
					I create thoughtful digital experiences with a focus on clean design and meaningful interaction.
					My work sits at the intersection of design and technology, bringing ideas to life through code.
				</p>
			</div>
		</section>

		<section class="work">
			<div class="container">
				<h2>Selected Work</h2>

				<article class="project">
					<h3>Project One</h3>
					<p class="project-description">A minimalist e-commerce platform focusing on sustainable fashion</p>
					<span class="year">2024</span>
				</article>

				<article class="project">
					<h3>Project Two</h3>
					<p class="project-description">Brand identity and web presence for a contemporary art gallery</p>
					<span class="year">2024</span>
				</article>

				<article class="project">
					<h3>Project Three</h3>
					<p class="project-description">Digital strategy and product design for a fintech startup</p>
					<span class="year">2023</span>
				</article>

				<article class="project">
					<h3>Project Four</h3>
					<p class="project-description">Interactive data visualization for environmental research</p>
					<span class="year">2023</span>
				</article>
			</div>
		</section>

		<section class="contact">
			<div class="container">
				<h2>Contact</h2>
				<div class="links">
					<a href="mailto:hello@example.com">Email</a>
					<a href="https://twitter.com" target="_blank" rel="noopener">Twitter</a>
					<a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
					<a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a>
				</div>
			</div>
		</section>

		<footer>
			<div class="container">
				<p>&copy; 2024. All rights reserved.</p>
			</div>
		</footer>
	</main>
</Layout>

<style>
	main {
		max-width: 100%;
		margin: 0 auto;
	}

	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 32px;
	}

	section {
		padding: 80px 0;
		border-bottom: 1px solid #e5e5e5;
	}

	.hero {
		min-height: 80vh;
		display: flex;
		align-items: center;
		border-bottom: none;
	}

	h1 {
		font-size: 48px;
		font-weight: 300;
		letter-spacing: -0.02em;
		margin-bottom: 16px;
	}

	.subtitle {
		font-size: 20px;
		color: #666;
		font-weight: 300;
	}

	h2 {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 40px;
		color: #999;
	}

	.about p {
		font-size: 24px;
		line-height: 1.7;
		max-width: 600px;
		font-weight: 300;
	}

	.project {
		margin-bottom: 64px;
		padding-bottom: 64px;
		border-bottom: 1px solid #f0f0f0;
		transition: transform 0.3s ease;
	}

	.project:last-of-type {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.project:hover {
		transform: translateX(8px);
	}

	.project h3 {
		font-size: 32px;
		font-weight: 400;
		margin-bottom: 8px;
		letter-spacing: -0.01em;
	}

	.project-description {
		font-size: 18px;
		color: #666;
		margin-bottom: 16px;
		line-height: 1.6;
	}

	.year {
		font-size: 14px;
		color: #999;
		font-weight: 400;
	}

	.links {
		display: flex;
		gap: 32px;
		flex-wrap: wrap;
	}

	.links a {
		font-size: 18px;
		color: #1a1a1a;
		text-decoration: none;
		position: relative;
		transition: color 0.3s ease;
	}

	.links a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 1px;
		background: #1a1a1a;
		transition: width 0.3s ease;
	}

	.links a:hover {
		color: #666;
	}

	.links a:hover::after {
		width: 100%;
	}

	footer {
		padding: 48px 0;
	}

	footer p {
		font-size: 14px;
		color: #999;
		text-align: center;
	}

	@media (max-width: 768px) {
		.container {
			padding: 0 24px;
		}

		section {
			padding: 60px 0;
		}

		.hero {
			min-height: 70vh;
		}

		h1 {
			font-size: 36px;
		}

		.subtitle {
			font-size: 18px;
		}

		.about p {
			font-size: 20px;
		}

		.project h3 {
			font-size: 24px;
		}

		.project-description {
			font-size: 16px;
		}

		.project {
			margin-bottom: 48px;
			padding-bottom: 48px;
		}

		.links {
			gap: 24px;
		}
	}
</style>
