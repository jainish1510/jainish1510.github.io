---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="landing">
		<div class="hero-section">
			<div class="hero-content">
				<div class="profile-image">
					<img src="/original-6df24e02f6bd8240fb108f9774eec8e2.webp" alt="Profile" />
					<div class="image-border"></div>
				</div>
				<div class="hero-text">
					<h1>Jainish Patel</h1>
					<p class="tagline">Developer & Designer</p>
					<p class="description">Creating meaningful digital experiences with passion and precision</p>
				</div>
			</div>
		</div>

		<div class="navigation-cards">
			<a href="/about" class="nav-card">
				<div class="card-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
						<circle cx="12" cy="7" r="4"></circle>
					</svg>
				</div>
				<h2>About Me</h2>
				<p>Explore my journey, interests, and what I'm currently working on</p>
				<span class="card-arrow">→</span>
			</a>

			<a href="/cv" class="nav-card">
				<div class="card-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
						<polyline points="10 9 9 9 8 9"></polyline>
					</svg>
				</div>
				<h2>My CV</h2>
				<p>View my experience, skills, and download my resume</p>
				<span class="card-arrow">→</span>
			</a>

			<a href="/contact" class="nav-card">
				<div class="card-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
						<polyline points="22,6 12,13 2,6"></polyline>
					</svg>
				</div>
				<h2>Contact</h2>
				<p>Let's connect and discuss potential collaborations</p>
				<span class="card-arrow">→</span>
			</a>
		</div>

		<div class="floating-elements">
			<div class="float-circle circle-1"></div>
			<div class="float-circle circle-2"></div>
			<div class="float-circle circle-3"></div>
		</div>
	</main>
</Layout>

<style>
	.landing {
		min-height: 100vh;
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
	}

	.hero-section {
		min-height: 60vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80px 32px 60px;
		position: relative;
		z-index: 2;
	}

	.hero-content {
		max-width: 1200px;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 80px;
	}

	.profile-image {
		position: relative;
		flex-shrink: 0;
	}

	.profile-image img {
		width: 280px;
		height: 280px;
		border-radius: 50%;
		object-fit: cover;
		position: relative;
		z-index: 2;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
		border: 6px solid white;
	}

	.image-border {
		position: absolute;
		top: -15px;
		left: -15px;
		right: -15px;
		bottom: -15px;
		border: 2px solid #1a1a1a;
		border-radius: 50%;
		z-index: 1;
		opacity: 0.2;
	}

	.hero-text {
		flex: 1;
	}

	.hero-text h1 {
		font-size: 64px;
		font-weight: 600;
		margin-bottom: 16px;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #1a1a1a 0%, #4a4a4a 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.tagline {
		font-size: 28px;
		color: #666;
		margin-bottom: 24px;
		font-weight: 300;
	}

	.description {
		font-size: 18px;
		color: #888;
		line-height: 1.6;
		max-width: 500px;
	}

	.navigation-cards {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 32px 80px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
		position: relative;
		z-index: 2;
	}

	.nav-card {
		background: white;
		padding: 48px 36px;
		border-radius: 24px;
		text-decoration: none;
		color: inherit;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 0, 0, 0.05);
	}

	.nav-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
		opacity: 0;
		transition: opacity 0.4s ease;
		z-index: 0;
	}

	.nav-card:hover::before {
		opacity: 1;
	}

	.nav-card:hover {
		transform: translateY(-12px);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
	}

	.card-icon {
		width: 56px;
		height: 56px;
		background: #1a1a1a;
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 24px;
		transition: all 0.4s ease;
		position: relative;
		z-index: 1;
	}

	.card-icon svg {
		width: 28px;
		height: 28px;
		color: white;
	}

	.nav-card:hover .card-icon {
		transform: scale(1.1) rotate(5deg);
		background: #2a2a2a;
	}

	.nav-card h2 {
		font-size: 28px;
		font-weight: 600;
		margin-bottom: 12px;
		letter-spacing: -0.01em;
		position: relative;
		z-index: 1;
	}

	.nav-card p {
		font-size: 16px;
		color: #666;
		line-height: 1.6;
		margin-bottom: 24px;
		position: relative;
		z-index: 1;
	}

	.card-arrow {
		display: inline-block;
		font-size: 24px;
		font-weight: 600;
		color: #1a1a1a;
		transition: transform 0.4s ease;
		position: relative;
		z-index: 1;
	}

	.nav-card:hover .card-arrow {
		transform: translateX(8px);
	}

	.floating-elements {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		pointer-events: none;
		overflow: hidden;
	}

	.float-circle {
		position: absolute;
		border-radius: 50%;
		background: linear-gradient(135deg, rgba(26, 26, 26, 0.03) 0%, rgba(26, 26, 26, 0.08) 100%);
		animation: float 20s ease-in-out infinite;
	}

	.circle-1 {
		width: 300px;
		height: 300px;
		top: 10%;
		right: 5%;
		animation-delay: 0s;
	}

	.circle-2 {
		width: 200px;
		height: 200px;
		bottom: 15%;
		left: 10%;
		animation-delay: -7s;
	}

	.circle-3 {
		width: 150px;
		height: 150px;
		top: 50%;
		right: 20%;
		animation-delay: -14s;
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(30px, -30px) scale(1.1);
		}
		66% {
			transform: translate(-20px, 20px) scale(0.9);
		}
	}

	@media (max-width: 1024px) {
		.hero-content {
			flex-direction: column;
			gap: 48px;
			text-align: center;
		}

		.hero-text {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		.hero-text h1 {
			font-size: 48px;
		}

		.navigation-cards {
			grid-template-columns: 1fr;
			max-width: 600px;
		}
	}

	@media (max-width: 768px) {
		.hero-section {
			padding: 60px 24px 40px;
		}

		.profile-image img {
			width: 220px;
			height: 220px;
		}

		.hero-text h1 {
			font-size: 40px;
		}

		.tagline {
			font-size: 22px;
		}

		.navigation-cards {
			padding: 0 24px 60px;
			gap: 24px;
		}

		.nav-card {
			padding: 36px 28px;
		}
	}
</style>
