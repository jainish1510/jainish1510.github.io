# ─── Core ───────────────────────────────────────────────────────────────
# SQLite file, relative to the project root.
DATABASE_URL="file:./data/portfolio.db"

# Public origin used for canonical URLs, sitemap, OpenGraph and CSRF checks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 32+ random characters. Signs anonymous visitor ids and hashes IPs.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ─── Admin bootstrap (read only by `npm run db:seed`) ─────────────────
# If ADMIN_PASSWORD is empty the seed generates a random one and prints it once.
# Never commit real values. Minimum 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Jainish Patel"

# ─── Optional integrations (the site works without them) ─────────────
# GitHub: username is public; a token (no scopes needed) raises rate limits
# and enables the contribution calendar via GraphQL.
GITHUB_USERNAME="jainish1510"
GITHUB_TOKEN=""

# Spotify "currently playing". Leave empty to use the demo/fallback state
# configured in /admin/widgets. See README → Spotify for the refresh-token flow.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
